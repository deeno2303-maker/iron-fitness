# Copy this file to .env and fill in real values. NEVER commit .env
PORT=5000
DATABASE_URL=PASTE_YOUR_NEON_CONNECTION_STRING_HERE
JWT_SECRET=replace_with_a_long_random_string
# Comma-separated list of frontend URLs allowed to call the API
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
# Gmail SMTP notifications (use a Google App Password, not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
TRIAL_TO_EMAIL=slowmoe.7860@gmail.com
